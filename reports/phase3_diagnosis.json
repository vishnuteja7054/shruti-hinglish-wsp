  "testable_hypotheses": [
    {
      "id": "H1 (Step-0 Language Tag Subspace Steering & European Tag Suppression)",
      "target_tensors": [
        "embedding/embedding[8906:8914, :]"
      ],
      "num_params_changed": 4096,
      "pct_of_model": "0.00738%",
      "mathematical_formulation": "E'[8906] = E[8906] + 0.5 * (gamma * u_Fisher + beta * mu_0_unit), E'[8913] = E[8913] - 0.5 * (gamma * u_Fisher + beta * mu_0_unit), E'[8907:8913] = E[8907:8913] - 2.0 * mu_0_unit",
      "expected_impact": "Eliminates step-0 Hindi/European misrouting on Svarah Indian English and LibriSpeech while preserving >99% Hindi Auto-LID accuracy on FLEURS, Lahaja, and MUCS Hinglish, with cos(e_orig, e_new) > 0.999 so Forced-LID decoding is unperturbed."
    },
    {
      "id": "H2 (Devanagari Output Projection Norm Equalization for Hinglish & Hindi)",
      "target_tensors": [
        "embedding/embedding[8192:8906, :]"
      ],
      "num_params_changed": 365568,
      "pct_of_model": "0.658%",
      "mathematical_formulation": "E'[8192:8906] = alpha_dev * E[8192:8906] with alpha_dev in [1.03, 1.09] calibrated on Dev split. Because Decoder Layer 0 applies scale-invariant _rms_unit(x) to input token embeddings whereas the output projection logits = aq(h) @ E.T is linear in ||E[t]||_2, radial scaling boosts Devanagari output logits by alpha_dev while keeping input directions invariant.",
      "expected_impact": "Reduces Latin over-prediction and Devanagari->Latin script mismatches on MUCS Hinglish and improves Devanagari word recall on Hindi benchmarks."
    },
    {
      "id": "H3 (Contrastive Pairwise Decoupling & Norm Balancing of High-Confusion Devanagari Tokens)",
      "target_tensors": [
        "embedding/embedding[selected_devanagari_ids, :]"
      ],
      "num_params_changed": "5120 - 15360",
      "pct_of_model": "< 0.03%",
      "mathematical_formulation": "For confused Devanagari token pairs (i, j) with cos(e_i, e_j) > 0.85 and systematic substitution bias on Dev splits, apply small orthogonal repulsion e_i' = e_i + eta * (e_i - <e_i, hat{e}_j> hat{e}_j) and norm-balance adjustment.",
      "expected_impact": "Reduces recurring Hindi function-word and nasalization/matra confusions (e.g., है/हैं, की/के, मैं/में) without altering acoustic encoder weights."
    },
    {
      "id": "H4 (Decoder Cross-Attention & Engram Gate Calibration)",
      "target_tensors": [
        "stack/layers/block/attn_gate",
        "engrams_0/embedding",
        "engrams_1/embedding"
      ],
      "num_params_changed": "16 - 2097152",
      "mathematical_formulation": "Test whether scaling final decoder cross-attention gates or damping noisy bigram/trigram engram injections improves accented speech robustness or induces regressions.",
      "expected_impact": "Provides a direct falsifiable test of decoder internal gate/engram sensitivity vs. output-space embedding geometry."
    }
  ]
